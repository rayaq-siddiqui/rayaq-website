[Unit]
Description=rayaq-website Flask app
After=network.target

[Service]
User=rayaq
WorkingDirectory=/opt/rayaq-website/backend
EnvironmentFile=-/etc/rayaq-website.env
Environment=FLIGHTS_DB_PATH=/var/lib/rayaq-website/flights.db
ExecStart=/opt/rayaq-website/backend/venv/bin/gunicorn -b 127.0.0.1:8000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
